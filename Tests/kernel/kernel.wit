package planner:kernelworld;

interface plan {

    record imagedata {
        width: u32,
        height: u32,
        pixels: list<u8>,
        reply-to: string,
        kernels: list<u8>,
        current-kernel: u32,
        request: u32
    }
  
    grayscale: func(img: imagedata) -> imagedata;
    invert: func(img: imagedata) -> imagedata;
    sobel: func(img: imagedata) -> imagedata;
    
}

world kernelworld {

    export plan;

}