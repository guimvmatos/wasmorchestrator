package planner:convworld;

interface plan {
  record data {
    input: list<f32>,
    output: list<f32>,
    reply-to: string,
    kernels: list<u8>,
    current-kernel: u32,
    request: u32,
  }

  conv: func(c-out: u32, c-in: u32, h-in: u32, w-in: u32, kh: u32, kw: u32, stride: u32, padding: u32, weights: list<f32>, img: data) -> data;
}

world convworld-gpu {
  import wasi:webgpu/webgpu@0.3.0-rc.2;
  import wasi-gfx-runtime:wasi-webgpu/sync-io;

  export plan;
}
