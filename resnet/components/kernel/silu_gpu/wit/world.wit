package planner:siluworld;

interface plan {

    record data {
        input: list<f32>,
        output: list<f32>,
        reply-to: string,
        kernels: list<u8>,
        current-kernel: u32,
        request: u32
    }

    silu: func(img: data) -> data;

}

world siluworld-gpu {
    import wasi:webgpu/webgpu@0.3.0-rc.2;
    import wasi-gfx-runtime:wasi-webgpu/sync-io;
    export plan;
}
