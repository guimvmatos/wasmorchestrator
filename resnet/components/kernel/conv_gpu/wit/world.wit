package planner:convworld;

// 10/11 (4c): via residente na GPU. Device do grupo (borrow) e tensores como
// handles de buffers da GPU. O record data fica só por compatibilidade (o
// grupo usa o tipo para serializar na rede).
interface plan {
    use wasi:webgpu/webgpu@0.3.0-rc.2.{gpu-device, gpu-buffer};

    record data {
        input: list<f32>,
        output: list<f32>,
        reply-to: string,
        kernels: list<u8>,
        current-kernel: u32,
        request: u32,
        from-step: u32,
    model-id: u32
    }

    conv-load-weights: func(dev: borrow<gpu-device>, weight-id: string, weights: list<f32>, bias: list<f32>);
    conv-r: func(dev: borrow<gpu-device>, weight-id: string, c-out: u32, c-in: u32, h-in: u32, w-in: u32, kh: u32, kw: u32, stride: u32, padding: u32, groups: u32, input: borrow<gpu-buffer>) -> gpu-buffer;
}

world convworld-gpu {
    import wasi:webgpu/webgpu@0.3.0-rc.2;
    export plan;
}
