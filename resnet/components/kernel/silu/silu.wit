package planner:siluworld;

interface plan {

    record data {
        input: list<f32>,
        output: list<f32>,
        reply-to: string,
        kernels: list<u8>,
        current-kernel: u32,
        request: u32,
        from-step: u32,
    model-id: u32
    }

    silu: func(img: data) -> data;

}

world siluworld {
    export plan;
}