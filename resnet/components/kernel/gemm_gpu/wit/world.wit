package planner:gemmworld;

interface plan {

    record data {
        input: list<f32>,
        output: list<f32>,
        reply-to: string,
        kernels: list<u8>,
        current-kernel: u32,
        request: u32
    }
  
    gemm: func(
        in-features: u32, 
        out-features: u32, 
        weights: list<f32>, 
        bias: list<f32>, 
        result-container: data
    ) -> data;
    
}

world gemmworld-gpu {
    import wasi:webgpu/webgpu@0.3.0-rc.2;
    import wasi-gfx-runtime:wasi-webgpu/sync-io;
    export plan;
}
