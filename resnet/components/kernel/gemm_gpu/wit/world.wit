package planner:gemmworld;

interface plan {

    record data {
        input: list<f32>,
        output: list<f32>,
        reply-to: string,
        kernels: list<u8>,
        current-kernel: u32,
        request: u32
    }

    // Carrega e cacheia pesos+bias uma vez por weight-id, no lado GPU.
    // Chamado apenas na primeira vez que este processo vê este weight-id;
    // chamadas seguintes pulam o marshalling de weights/bias pela fronteira
    // WIT inteira (confirmado ~81ms pra 411MB, proporcional ao tamanho).
    gemm-load-weights: func(weight-id: string, weights: list<f32>, bias: list<f32>);

    // Computa usando o buffer já cacheado para weight-id. Panica se
    // gemm-load-weights não foi chamado antes para esse weight-id.
    gemm: func(weight-id: string, in-features: u32, out-features: u32, img: data) -> data;

}

world gemmworld-gpu {
    import wasi:webgpu/webgpu@0.3.0-rc.2;
    import wasi-gfx-runtime:wasi-webgpu/sync-io;
    export plan;
}