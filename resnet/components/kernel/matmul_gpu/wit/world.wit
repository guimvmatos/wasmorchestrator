package planner:matmulworld;

interface plan {

    record data {
        input: list<f32>,
        output: list<f32>,
        reply-to: string,
        kernels: list<u8>,
        current-kernel: u32,
        request: u32,
        from-step: u32,
    model-id: u32
    }

    matmul: func(
        lhs: list<f32>,
        rhs: list<f32>,
        lhs-shape: list<u32>,
        rhs-shape: list<u32>,
        result-container: data
    ) -> data;

}

world matmulworld-gpu {
    import wasi:webgpu/webgpu@0.3.0-rc.2;
    import wasi-gfx-runtime:wasi-webgpu/sync-io;
    export plan;
}
