package planner:bnworld;

// 10/11 (4c): via residente na GPU. Device do grupo (borrow) e tensores como
// handles de buffers da GPU. O record data fica só por compatibilidade (o
// grupo usa o tipo para serializar na rede).
interface plan {
    use wasi:webgpu/webgpu@0.3.0-rc.2.{gpu-device, gpu-buffer};

    record data {
        input: list<f32>,
        output: list<f32>,
        reply-to: string,
        kernels: list<u8>,
        current-kernel: u32,
        request: u32,
        from-step: u32,
    model-id: u32
    }

    bn-load-weights: func(dev: borrow<gpu-device>, weight-id: string, scale: list<f32>, beta: list<f32>, mean: list<f32>, var: list<f32>);
    bn-r: func(dev: borrow<gpu-device>, weight-id: string, channels: u32, h-in: u32, w-in: u32, epsilon: f32, input: borrow<gpu-buffer>) -> gpu-buffer;
}

world bnworld-gpu {
    import wasi:webgpu/webgpu@0.3.0-rc.2;
    export plan;
}
