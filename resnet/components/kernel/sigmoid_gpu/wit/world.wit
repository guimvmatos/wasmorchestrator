package planner:sigmoidworld;

interface plan {

    record data {
        input: list<f32>,
        output: list<f32>,
        reply-to: string,
        kernels: list<u8>,
        current-kernel: u32,
        request: u32,
        from-step: u32,
    model-id: u32
    }

    sigmoid: func(img: data) -> data;

}

world sigmoidworld-gpu {
    import wasi:webgpu/webgpu@0.3.0-rc.2;
    import wasi-gfx-runtime:wasi-webgpu/sync-io;
    export plan;
}