package planner:mulworld;

interface plan {

    record data {
        input: list<f32>,
        output: list<f32>,
        reply-to: string,
        kernels: list<u8>,
        current-kernel: u32,
        request: u32,
        from-step: u32
    }

    mul: func(a: list<f32>, b: list<f32>, result-container: data) -> data;

}

world mulworld {
    export plan;
}